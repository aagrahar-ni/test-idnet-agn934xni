Property Value: 1250010

"
attribute: "Frequency Span Mode"
	"Basic Operation:Frequency Span Mode"
	iL enum { AGN934XNI_VAL_FREQUENCY_SPAN_MODE_FULL=1, AGN934XNI_VAL_FREQUENCY_SPAN_MODE_ZERO=2, AGN934XNI_VAL_FREQUENCY_SPAN_MODE_PREVIOUS=3 } writeonly 1 119028
	//const: AGN934XNI_ATTR_FREQUENCY_SPAN_MODE
