  Select a value by double-clicking on it or by selecting it and 
  then pressing &lt;ENTER&gt;.  
</HelpText>
<FPOutputCtrl>
<DisplayFormat>kfpDecimal</DisplayFormat>
<DefaultValue>
</DefaultValue>
</FPOutputCtrl>
</FPCtrl>
