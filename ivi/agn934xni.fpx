</FunctionQualifier>
<HelpText>This function specifies at which level and slope of the video signal, acquisition is triggered. This is applicable when the Trigger Source attribute is set to Video.</HelpText>
<FPCtrl label="Instrument Handle">
<XPos>25</XPos>
<YPos>301</YPos>
<CtrlWidth>145</CtrlWidth>
<ParamPosition>1</ParamPosition>
<CtrlDataTypeIfBuiltIn/>
<CtrlDataTypeIfUserDefined>ViSession</CtrlDataTypeIfUserDefined>
