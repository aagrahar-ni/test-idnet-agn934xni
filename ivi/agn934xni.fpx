<LabelValue label="Maximum Hold">AGN934XNI_VAL_TRACE_TYPE_MAX_HOLD</LabelValue>
<LabelValue label="Minimum Hold">AGN934XNI_VAL_TRACE_TYPE_MIN_HOLD</LabelValue>
<LabelValue label="View">AGN934XNI_VAL_TRACE_TYPE_VIEW</LabelValue>
<LabelValue label="Store">AGN934XNI_VAL_TRACE_TYPE_STORE</LabelValue>
</FPRingCtrl>
</FPCtrl>
