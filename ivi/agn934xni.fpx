<CtrlWidth>145</CtrlWidth>
<ParamPosition>4</ParamPosition>
<CtrlDataTypeIfBuiltIn/>
<CtrlDataTypeIfUserDefined>ViReal64</CtrlDataTypeIfUserDefined>
<HelpText>Return the lower adjacent channel power to main channel power ratio.

Unit: dB</HelpText>
<FPOutputCtrl>
<DisplayFormat>kfpDecimal</DisplayFormat>
<DefaultValue>
</DefaultValue>
</FPOutputCtrl>
</FPCtrl>
<FPCtrl label="Upper ACP">
<XPos>25</XPos>
<YPos>128</YPos>
<CtrlWidth>145</CtrlWidth>
<ParamPosition>5</ParamPosition>
<CtrlDataTypeIfBuiltIn/>
<CtrlDataTypeIfUserDefined>ViReal64</CtrlDataTypeIfUserDefined>
<HelpText>Return the upper adjacent channel power of ACPR measurement.

Unit: dBm</HelpText>
<FPOutputCtrl>
<DisplayFormat>kfpDecimal</DisplayFormat>
<DefaultValue>
</DefaultValue>
</FPOutputCtrl>
</FPCtrl>
<FPCtrl label="Upper ACPR">
<XPos>206</XPos>
<YPos>128</YPos>
<CtrlWidth>145</CtrlWidth>
<ParamPosition>6</ParamPosition>
<CtrlDataTypeIfBuiltIn/>
<CtrlDataTypeIfUserDefined>ViReal64</CtrlDataTypeIfUserDefined>
<HelpText>Return the upper adjacent channel power to main channel power ratio.

Unit: dB</HelpText>
<FPOutputCtrl>
<DisplayFormat>kfpDecimal</DisplayFormat>
<DefaultValue>
</DefaultValue>
</FPOutputCtrl>
</FPCtrl>
<FPCtrl label="Main Channel Power">
