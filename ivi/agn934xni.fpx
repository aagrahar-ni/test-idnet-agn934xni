<LabelValue label="Next Peak Right">AGN934XNI_VAL_MARKER_SEARCH_NEXT_PEAK_RIGHT</LabelValue>
<LabelValue label="Next Peak">AGN934XNI_VAL_MARKER_SEARCH_NEXT_PEAK</LabelValue>
</FPRingCtrl>
</FPCtrl>
